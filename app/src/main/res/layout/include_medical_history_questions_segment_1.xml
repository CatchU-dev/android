            android:background="@drawable/view_bg_round_outline_navy"
            android:text="@string/no"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="@+id/tvHeartDiseaseYes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvHeartDiseaseYes" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvHeartDiseaseError"
            style="@style/TextViewError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/required"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tvHeartDisease"
            app:layout_constraintTop_toBottomOf="@+id/tvHeartDisease"
