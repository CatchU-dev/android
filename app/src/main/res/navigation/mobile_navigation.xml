<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/launchFragment">

    <fragment
        android:id="@+id/launchFragment"
        android:name="com.isaacsufyan.catchu.presentation.fragments.launch.LaunchFragment"
        tools:layout="@layout/fragment_launch">

        <action
            android:id="@+id/action_launch_to_language"
            app:destination="@id/languageFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/launchFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/languageFragment"
        android:name="com.isaacsufyan.catchu.presentation.fragments.language.LanguageFragment"
        tools:layout="@layout/fragment_language">

        <action
            android:id="@+id/action_language_to_community_ind"
            app:destination="@id/communityIdentificationFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/languageFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_language_to_profile_details"
            app:destination="@id/patientDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/languageFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/communityIdentificationFragment"
        android:name="com.isaacsufyan.catchu.presentation.fragments.community_indentification.CommunityIdentificationFragment"
        tools:layout="@layout/fragment_community_identification">

        <action
            android:id="@+id/action_community_ind_to_group_details"
            app:destination="@id/groupTestDetailsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/communityIdentificationFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/groupTestDetailsFragment"
        android:name="com.isaacsufyan.catchu.presentation.fragments.group_test_details.GroupTestDetailsFragment"
        tools:layout="@layout/fragment_group_test_details">

        <action
            android:id="@+id/action_group_details_to_current_group"
            app:destination="@id/currentGroupTestFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/groupTestDetailsFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/currentGroupTestFragment"
        android:name="com.isaacsufyan.catchu.presentation.fragments.current_group_test.CurrentGroupTestFragment"
        tools:layout="@layout/fragment_current_group_test">

        <action
            android:id="@+id/action_current_group_to_community_ind"
            app:destination="@id/communityIdentificationFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/currentGroupTestFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_current_group_to_patient_profile"
            app:destination="@id/patientDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/currentGroupTestFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/patientDetailFragment"
        android:name="com.isaacsufyan.catchu.presentation.fragments.patient_details.PatientDetailsFragment"
        tools:layout="@layout/fragment_patient_details">

        <action
            android:id="@+id/action_patient_detail_to_term_and_condition"
            app:destination="@id/termsAndConditionFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/patientDetailFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_bypass_term_and_condition_and_move_to_instruction"
            app:destination="@id/instructionBeforeTesting"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/patientDetailFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/termsAndConditionFragment"
        android:name="com.isaacsufyan.catchu.presentation.fragments.terms_and_condition.TermsAndConditionFragment"
        tools:layout="@layout/fragment_terms_and_condition">

        <action
            android:id="@+id/action_term_and_condition_to_patient_detail"
            app:destination="@id/patientDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/termsAndConditionFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_term_and_condition_to_instruction"
            app:destination="@id/instructionBeforeTesting"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/termsAndConditionFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/instructionBeforeTesting"
        android:name="com.isaacsufyan.catchu.presentation.fragments.instruction_before_testing.InstructionBeforeTestingFragment"
        tools:layout="@layout/fragment_instruction_before_testing">

        <action
            android:id="@+id/action_instruction_to_demo_graphics"
            app:destination="@id/demoGraphicAndMedicalHistory"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/instructionBeforeTesting"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/demoGraphicAndMedicalHistory"
        android:name="com.isaacsufyan.catchu.presentation.fragments.demo_graphic.DemoGraphicAndMedicalHistoryFragment"
        tools:layout="@layout/fragment_demo_graphic_and_medical_history">

<!--        <action-->
<!--            android:id="@+id/action_demo_to_test"-->
<!--            app:destination="@id/testFragment"-->
<!--            app:enterAnim="@anim/slide_in_right"-->
<!--            app:exitAnim="@anim/slide_out_left"-->
<!--            app:popEnterAnim="@anim/slide_in_left"-->
<!--            app:popExitAnim="@anim/slide_out_right"-->
<!--            app:popUpTo="@+id/demoGraphicAndMedicalHistory"-->
<!--            app:popUpToInclusive="true" />-->

    </fragment>

    <fragment
        android:id="@+id/testFragment"
        android:name="com.isaacsufyan.catchu.presentation.fragments.test.TestFragment"
        tools:layout="@layout/fragment_test" />

</navigation>