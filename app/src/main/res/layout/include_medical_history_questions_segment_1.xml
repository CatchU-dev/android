            app:layout_constraintEnd_toStartOf="@+id/tvDiabetesYes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewArthritis" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDiabetesYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_4sdp"
            android:background="@drawable/view_bg_round_outline_navy"
            android:text="@string/yes"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@+id/viewDiabetes"
            app:layout_constraintEnd_toStartOf="@+id/tvDiabetesNo"
            app:layout_constraintTop_toBottomOf="@+id/viewArthritis" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDiabetesNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/view_bg_round_outline_navy"
            android:text="@string/no"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="@+id/tvDiabetesYes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvDiabetesYes" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDiabetesError"
            style="@style/TextViewError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/required"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tvDiabetes"
            app:layout_constraintTop_toBottomOf="@+id/tvDiabetes" />

        <View
            android:id="@+id/viewDiabetes"
            style="@style/HorizontalLineStyle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvDiabetes"
            app:layout_constraintTop_toBottomOf="@+id/tvDiabetesError" />

        <include
