<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardViewStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/_4sdp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvMedicalConditionQuestions"
            style="@style/TextViewNormalStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doctor_described_medical_conditions"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Hypertension-->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvHypertension"
            style="@style/TextViewNormalStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:text="@string/hypertension"
            app:layout_constraintEnd_toStartOf="@+id/tvHypertensionYes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMedicalConditionQuestions" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvHypertensionYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_4sdp"
            android:background="@drawable/view_bg_round_outline_navy"
            android:text="@string/yes"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@+id/viewHyperTension"
            app:layout_constraintEnd_toStartOf="@+id/tvHypertensionNo"
            app:layout_constraintTop_toBottomOf="@+id/tvMedicalConditionQuestions" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvHypertensionNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/view_bg_round_outline_navy"
            android:text="@string/no"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="@+id/tvHypertensionYes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvHypertensionYes" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvHypertensionError"
            style="@style/TextViewError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/required"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tvHypertension"
            app:layout_constraintTop_toBottomOf="@+id/tvHypertension" />

        <View
            android:id="@+id/viewHyperTension"
            style="@style/HorizontalLineStyle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvHypertension"
            app:layout_constraintTop_toBottomOf="@+id/tvHypertensionError" />

        <!-- Arthritis-->

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvArthritis"
            style="@style/TextViewNormalStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:text="@string/arthritis"
            app:layout_constraintEnd_toStartOf="@+id/tvArthritisYes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewHyperTension" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvArthritisYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_4sdp"
            android:background="@drawable/view_bg_round_outline_navy"
            android:text="@string/yes"
            android:textColor="?attr/colorPrimary"
