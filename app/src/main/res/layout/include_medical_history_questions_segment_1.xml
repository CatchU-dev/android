        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvOsteoporosisYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_4sdp"
            android:background="@drawable/view_bg_round_outline_navy"
            android:text="@string/yes"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toTopOf="@+id/viewOsteoporosis"
            app:layout_constraintEnd_toStartOf="@+id/tvOsteoporosisNo"
            app:layout_constraintTop_toBottomOf="@+id/viewChronic" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvOsteoporosisNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/view_bg_round_outline_navy"
            android:text="@string/no"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="@+id/tvOsteoporosisYes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvOsteoporosisYes" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvOsteoporosisError"
            style="@style/TextViewError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/required"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tvOsteoporosis"
            app:layout_constraintTop_toBottomOf="@+id/tvOsteoporosis"
            tools:visibility="gone" />

