        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvAnxietyNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/view_bg_round_outline_navy"
            android:text="@string/no"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="@+id/tvAnxietyYes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvAnxietyYes" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvAnxietyError"
            style="@style/TextViewError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/required"
            android:visibility="gone"
