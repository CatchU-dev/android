<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/view_bg_rectangle_filled_light_gray"
    android:padding="@dimen/_4sdp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvFallInPastOneYearFracture"
        style="@style/TextViewNormalStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_4sdp"
        android:text="@string/result_in_fracture"
        app:layout_constraintEnd_toStartOf="@+id/tvFallInPastOneYearFractureYes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvFallInPastOneYearFractureYes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_4sdp"
        android:background="@drawable/view_bg_round_outline_navy"
        android:text="@string/yes"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@+id/viewFallInPastOneYearFracture"
        app:layout_constraintEnd_toStartOf="@+id/tvFallInPastOneYearFractureNo"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvFallInPastOneYearFractureNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/view_bg_round_outline_navy"
        android:text="@string/no"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFallInPastOneYearFractureYes" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvFallInPastOneYearFractureError"
        style="@style/TextViewError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/required"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/tvFallInPastOneYearFracture"
        app:layout_constraintTop_toBottomOf="@+id/tvFallInPastOneYearFracture"
        tools:visibility="visible" />

    <View
        android:id="@+id/viewFallInPastOneYearFracture"
        style="@style/HorizontalLineStyle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvFallInPastOneYearFracture"
        app:layout_constraintTop_toBottomOf="@+id/tvFallInPastOneYearFractureError" />

</androidx.constraintlayout.widget.ConstraintLayout>