<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/_20sdp"
    tools:context=".presentation.fragments.community_indentification.CommunityIdentificationFragment">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvScreenTitle"
        style="@style/TextViewHeadingStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/community_identification"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvCommunityId"
        style="@style/TextViewNormalStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="@string/community_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvScreenTitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/edtCommunityIdLayout"
        style="@style/TextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCommunityId">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtCommunityId"
            style="@style/EditTextStyle"
            android:layout_width="match_parent"
            android:text="OSHFR56C"
            android:layout_height="wrap_content"
            android:inputType="none" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmit"
        style="@style/MaterialButtonStyleFilled"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="@string/submit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtCommunityIdLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>