<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBlack"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintBottom_toTopOf="@+id/tvStartText"
        app:layout_constraintTop_toTopOf="parent">

        <!-- PD1 – Visual – chain head, spread style = equal gaps on left/between/right -->
        <View
            android:id="@+id/vPhotodiode1"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:visibility="invisible"
            app:layout_constraintEnd_toStartOf="@+id/vPhotodiode2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- PD2 – Somatosensory -->
        <View
            android:id="@+id/vPhotodiode2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:visibility="invisible"
            app:layout_constraintEnd_toStartOf="@+id/vPhotodiode3"
            app:layout_constraintStart_toEndOf="@+id/vPhotodiode1"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- PD3 – VS (Visual + Somatosensory) -->
        <View
            android:id="@+id/vPhotodiode3"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:visibility="invisible"
            app:layout_constraintEnd_toStartOf="@+id/vPhotodiode4"
            app:layout_constraintStart_toEndOf="@+id/vPhotodiode2"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- PD4 – Catch (no stimulus) – chain tail -->
        <View
            android:id="@+id/vPhotodiode4"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/vPhotodiode3"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivVisStimulusLeft"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="40dp"
            android:src="@drawable/asterisk"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivVisStimulusRight"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2"
            tools:visibility="visible" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivVisStimulusRight"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="40dp"
            android:src="@drawable/asterisk"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivVisStimulusLeft"
            app:layout_constraintTop_toTopOf="@+id/ivVisStimulusLeft"
            tools:visibility="visible" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFixationTarget"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/fixation_target"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.273" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvStartText"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#6A6A6A"
        android:gravity="center"
        android:padding="10dp"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clBlack"
        tools:text="@string/click_here_to_start" />

</androidx.constraintlayout.widget.ConstraintLayout>