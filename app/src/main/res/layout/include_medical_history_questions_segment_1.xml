            app:layout_constraintStart_toStartOf="@+id/tvDiabetes"
            app:layout_constraintTop_toBottomOf="@+id/viewDiabetes"
            tools:visibility="visible" />

        <!-- Depression-->

        <com.google.android.material.textview.MaterialTextView
