<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/view_bg_rectangle_filled_light_gray"
    android:padding="@dimen/_4sdp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvVisionRate"
        style="@style/TextViewNormalStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rate_vision_problems"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/edtVisionRateLayout"
        style="@style/DropDownStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:boxBackgroundColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvVisionRate">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/edtVisionRate"
            style="@style/EditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />

    </com.google.android.material.textfield.TextInputLayout>

    <View
        android:id="@+id/viewVisionRate"
        style="@style/HorizontalLineStyle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvVisionRate"
        app:layout_constraintTop_toBottomOf="@+id/edtVisionRateLayout" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvVisionGlasses"
        style="@style/TextViewNormalStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_4sdp"
        android:text="@string/glasses_contact_lenses"
        app:layout_constraintEnd_toStartOf="@+id/tvVisionGlassesYes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewVisionRate" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvVisionGlassesYes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_4sdp"
        android:background="@drawable/view_bg_round_outline_navy"
        android:text="@string/yes"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@+id/viewVisionGlasses"
        app:layout_constraintEnd_toStartOf="@+id/tvVisionGlassesNo"
        app:layout_constraintTop_toBottomOf="@+id/viewVisionRate" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvVisionGlassesNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/view_bg_round_outline_navy"
        android:text="@string/no"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvVisionGlassesYes" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvVisionGlassesError"
        style="@style/TextViewError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/required"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/tvVisionGlasses"
        app:layout_constraintTop_toBottomOf="@+id/tvVisionGlasses"
        tools:visibility="visible" />

    <View
        android:id="@+id/viewVisionGlasses"
        style="@style/HorizontalLineStyle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvVisionGlasses"
        app:layout_constraintTop_toBottomOf="@+id/tvVisionGlassesError" />

</androidx.constraintlayout.widget.ConstraintLayout>