<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/_10sdp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvScreenTitle"
        style="@style/TextViewHeadingStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/current_group_test"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clColumnHeading"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:background="?attr/colorOnTertiaryContainer"
        app:layout_constraintTop_toBottomOf="@+id/tvScreenTitle">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvFirstName"
            style="@style/TextViewNormalStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/view_bg_rectangle_outline_light_gray"
            android:gravity="center_vertical"
            android:text="@string/firstname"
            app:layout_constraintEnd_toStartOf="@+id/tvLastName"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvLastName"
            style="@style/TextViewNormalStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/view_bg_rectangle_outline_light_gray"
            android:gravity="center_vertical"
            android:text="@string/lastname"
            app:layout_constraintEnd_toStartOf="@+id/tvDOB"
            app:layout_constraintStart_toEndOf="@+id/tvFirstName" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDOB"
            style="@style/TextViewNormalStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/view_bg_rectangle_outline_light_gray"
            android:gravity="center_vertical"
            android:text="@string/dob"
            app:layout_constraintEnd_toStartOf="@+id/tvStatus"
            app:layout_constraintStart_toEndOf="@+id/tvLastName" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvStatus"
            style="@style/TextViewNormalStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/view_bg_rectangle_outline_light_gray"
            android:gravity="center_vertical"
            android:text="@string/status"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvDOB" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCurrentGroupTestTable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/btnResumeGroupTest"
        app:layout_constraintTop_toBottomOf="@+id/clColumnHeading"
        app:spanCount="1"
        android:visibility="gone"
        tools:itemCount="15"
        tools:listitem="@layout/list_item_group_test_table" />

    <TextView
        android:id="@+id/tvNoPatientRecordFound"
        style="@style/TextViewNormalStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/no_patient_record_found"
        app:layout_constraintBottom_toTopOf="@+id/btnResumeGroupTest"
        app:layout_constraintTop_toBottomOf="@+id/clColumnHeading" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResumeGroupTest"
        style="@style/MaterialButtonStyleFilled"
        android:layout_width="match_parent"
        android:text="@string/resume_group_test"
        app:layout_constraintBottom_toTopOf="@+id/btnTerminateGroupTest" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTerminateGroupTest"
        style="@style/MaterialButtonStyleOutline"
        android:layout_width="match_parent"
        android:text="@string/terminate_group_test"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>