<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_10sdp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvScreenTitle"
            style="@style/TextViewHeadingStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            android:text="@string/demographics_medical_history"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/includeSeg0"
            layout="@layout/include_medical_history_questions_segment_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_4sdp"
            app:layout_constraintTop_toBottomOf="@+id/tvScreenTitle" />

        <include
            android:id="@+id/includeSeg1"
            layout="@layout/include_medical_history_questions_segment_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            app:layout_constraintTop_toBottomOf="@+id/includeSeg0" />

        <include
            android:id="@+id/includeSeg2"
            layout="@layout/include_medical_history_questions_segment_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            app:layout_constraintTop_toBottomOf="@+id/includeSeg1" />

        <include
            android:id="@+id/includeSeg3"
            layout="@layout/include_medical_history_questions_segment_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            app:layout_constraintTop_toBottomOf="@+id/includeSeg2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartTrail"
            style="@style/MaterialButtonStyleFilled"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="@string/start_trial"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/includeSeg3" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>