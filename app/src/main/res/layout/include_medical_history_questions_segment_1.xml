            app:layout_constraintBottom_toTopOf="@+id/viewDepression"
            app:layout_constraintEnd_toStartOf="@+id/tvDepressionNo"
            app:layout_constraintTop_toBottomOf="@+id/includeDiabetesSubQuestions" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDepressionNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/view_bg_round_outline_navy"
            android:text="@string/no"
