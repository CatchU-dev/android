<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/view_bg_rectangle_filled_light_gray"
    android:padding="@dimen/_4sdp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvHearingAid"
        style="@style/TextViewNormalStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_4sdp"
        android:text="@string/hearing_aid"
        app:layout_constraintEnd_toStartOf="@+id/tvHearingAidYes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvHearingAidYes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_4sdp"
        android:background="@drawable/view_bg_round_outline_navy"
        android:text="@string/yes"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@+id/viewHearingAid"
        app:layout_constraintEnd_toStartOf="@+id/tvHearingAidNo"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvHearingAidNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/view_bg_round_outline_navy"
        android:text="@string/no"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvHearingAidYes" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvHearingAidError"
        style="@style/TextViewError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/required"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/tvHearingAid"
        app:layout_constraintTop_toBottomOf="@+id/tvHearingAid"
        tools:visibility="visible" />

    <View
        android:id="@+id/viewHearingAid"
        style="@style/HorizontalLineStyle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvHearingAid"
        app:layout_constraintTop_toBottomOf="@+id/tvHearingAidError" />

</androidx.constraintlayout.widget.ConstraintLayout>