            android:text="@string/yes"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="@id/viewChronic"
            app:layout_constraintEnd_toStartOf="@+id/tvChronicNo"
            app:layout_constraintTop_toBottomOf="@+id/viewDepression" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvChronicNo"
